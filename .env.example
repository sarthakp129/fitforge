# ============================================================================
# FitForge configuration
#
#   cp .env.example .env     then fill in GROQ_API_KEY and JWT_SECRET
#
# .env is gitignored. Never commit a real key.
# ============================================================================

# ---------------------------------------------------------------- Groq / AI --
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Leave true. Set false to force the deterministic local engine everywhere
# (useful offline, or to spend zero tokens while you test the UI).
GROQ_ENABLED=true

# Models. Groq retired llama-3.3-70b-versatile and llama-3.1-8b-instant on the
# free/developer tiers on 2026-08-16. These are the currently served models:
#   openai/gpt-oss-120b   best quality   (30 RPM / 8K TPM / 1K RPD)
#   openai/gpt-oss-20b    fastest/cheap  (30 RPM / 8K TPM / 1K RPD)
#   qwen/qwen3.8-27b      alternative    (30 RPM / 8K TPM / 1K RPD)
# Check what YOUR key can call:  curl -s localhost:8080/api/ai/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Tried in order if a model is missing from your tier. Leave empty for the
# built-in chain (120b -> 20b -> qwen3.8-27b).
GROQ_MODEL_CHAIN=

# ---- token governor ---------------------------------------------------------
# The governor never lets the app exceed these, and Groq's own response headers
# can only tighten them further, never loosen them.
# Free tier is 8K TPM / 30 RPM / 1K RPD. Defaults below stay safely inside that.
# If your key is on a smaller allowance (some free keys report 1K TPM), lower it.
GROQ_TPM=6000
GROQ_RPM=20
GROQ_RPD=900

# Output caps. gpt-oss are reasoning models, so reasoning tokens count too;
# 'low' keeps them cheap without making the plans dumb.
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS_PLAN=900
GROQ_MAX_TOKENS_CHAT=500
GROQ_TEMPERATURE=0.6
GROQ_TIMEOUT_MS=45000
GROQ_MAX_RETRIES=4

# Voice: Whisper speech-to-text works out of the box. Orpheus text-to-speech
# (spoken coach replies) needs a one-time terms acceptance in the Groq console
# (Models -> Orpheus -> Accept); until then the speaker toggle degrades to
# text with a friendly notice.

# Identical requests are served from SQLite for this long (seconds). 14 days.
GROQ_CACHE_TTL_SECONDS=1209600

# If the model is unreachable or the budget is gone, fall back to the local
# engine instead of returning an error. Keep this true.
ENGINE_FALLBACK=true

# Minimum seconds between two AI calls from the same user.
AI_COOLDOWN_SECONDS=5

# Allow logged-in users to retune the token governor and purge the AI cache
# at runtime (Settings page). Fine for single-tenant self-hosting; set false
# on any host where untrusted people can create accounts (see
# docs/SECURITY_REVIEW.md F-06).
AI_RUNTIME_TUNING=true

# ------------------------------------------------------------------- server --
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=2592000

# Host ports (container ports stay 8080 and 80).
WEB_PORT=8081
API_PORT=8080

# Comma-separated origins, or * for any. Only matters if you serve the SPA from
# a different origin than the API.
CORS_ORIGINS=*

# --------------------------------------------------------------------- data --
# Inside the container this is /app/data (a named Docker volume).
# For local (non-Docker) runs it defaults to ./data.
# DATA_DIR=/app/data
